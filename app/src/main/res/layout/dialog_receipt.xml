<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_white"
    android:padding="24dp">

    <!-- Receipt Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛽"
            android:textSize="36sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Petrol Calculator"
            android:textColor="@color/dark_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvReceiptDate"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Dashed divider top -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="- - - - - - - - - - - - - - - - - - - - - - - - - - - -"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Petrol Type row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Petrol Type"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPetrolType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Price per litre row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Price per Litre"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPricePerLitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Fuel usage row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fuel Usage"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFuelUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Total cost row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total Petrol Cost"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTotalCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- BUDI Rebate row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BUDI Rebate"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvBudiRebate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#059669"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Dashed divider middle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="- - - - - - - - - - - - - - - - - - - - - - - - - - - -"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Final payable total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FINAL PAYABLE"
            android:textColor="@color/dark_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFinalPayable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Dashed divider bottom -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="- - - - - - - - - - - - - - - - - - - - - - - - - - - -"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Thank you note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thank you for using Smart Petrol Calculator"
        android:textColor="@color/text_gray"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Close button -->
    <Button
        android:id="@+id/btnCloseReceipt"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/dark_blue" />

</LinearLayout>